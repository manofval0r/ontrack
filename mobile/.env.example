# Copy to .env for local Expo dev (Expo reads .env automatically).
# NOTE: only EXPO_PUBLIC_* vars reach the app bundle. Never put secrets here.
# Convention (mirrors web/.env.example, must match the mobile API layer):
# - EXPO_PUBLIC_API_URL is the BARE host, NO /api suffix (client appends /api/...).
#   Mobile builds point at the MOBILE backend instance, not web.
# - Auth uses EXPO_PUBLIC_SUPABASE_ANON_KEY (the sb_publishable_* key, public by design).

# Django mobile backend, bare host (e.g. https://your-api-mobile.onrender.com).
# Unset = calls fail.
EXPO_PUBLIC_API_URL=

# Supabase project (login fetches a JWT for Authorization: Bearer calls).
# sb_secret_* must NEVER go here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_change-me
