{
  "expo": {
    "name": "OnTrack",
    "slug": "ontrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ontrack",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#071E2D"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "OnTrack uses the microphone for voice goal input.",
        "NSSpeechRecognitionUsageDescription": "OnTrack transcribes your voice into goals and progress logs."
      }
    },
    "android": {
      "permissions": [
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#071E2D"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
