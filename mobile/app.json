{
  "expo": {
    "name": "OnTrack",
    "slug": "onTrack",
    "owner": "manofval0r",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ontrack",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#071E2D"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "bundleIdentifier": "com.manofval0r.ontrack",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "OnTrack uses the microphone for voice goal input.",
        "NSSpeechRecognitionUsageDescription": "OnTrack transcribes your voice into goals and progress logs."
      }
    },
    "android": {
      "package": "com.manofval0r.ontrack",
      "versionCode": 1,
      "permissions": [
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#00C4B3"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "05280680-78e6-484a-a927-248e9d12e79c"
      }
    }
  }
}
