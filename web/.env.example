# Copy to .env for local dev (Vite reads .env automatically).
# On Vercel: project Settings → Environment Variables (same keys), then Redeploy.
# NOTE: only VITE_* vars reach the browser. Never put secrets here.
# Convention (must match web/src/services/api.ts + Login/Signup):
# - VITE_API_URL is the BARE host, NO /api suffix (client appends /api/...).
# - Auth uses VITE_SUPABASE_ANON_KEY (the sb_publishable_* key).

# Django backend (bare host). Empty = calls fail (no mock fallback in current client).
VITE_API_URL=https://ontrack-api-web.onrender.com

# Supabase (email login fetches a JWT stored as ontrack_token).
# Publishable (anon) key is public by design; sb_secret_* must NEVER go here.
VITE_SUPABASE_URL=https://destcakvqdzhkzemdugo.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_kT5JCbb2BFocdW23HIJYfw_jk879gsk
