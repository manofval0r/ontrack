# Copy to .env for local dev (Vite reads .env automatically).
# On Vercel: project Settings → Environment Variables (same keys), then Redeploy.
# NOTE: only VITE_* vars reach the browser. Never put secrets here.
# Convention (must match web/src/services/api.ts + Login/Signup):
# - VITE_API_URL is the BARE host, NO /api suffix (client appends /api/...).
# - Auth uses VITE_SUPABASE_ANON_KEY (the sb_publishable_* key, public by design).

# Django backend, bare host (e.g. https://your-api.onrender.com for prod,
# http://127.0.0.1:8000 for local). Unset = calls fail (no mock fallback).
VITE_API_URL=

# Supabase project (email login fetches a JWT stored as ontrack_token).
# sb_secret_* must NEVER go here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_change-me
