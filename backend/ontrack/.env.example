# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True

# --- Instance identity: "web" or "mobile" (same codebase, two Render instances) ---
INSTANCE_NAME=web

# --- Database (Supabase pooler format, port 6543) ---
# Use the SERVICE_ROLE pooler string (bypasses RLS), not anon/JWT-scoped.
# Example: postgres://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ontrack

# --- Auth: Supabase JWT signing secret (HS256). Django verifies, never mints. ---
SUPABASE_JWT_SECRET=change-me

# --- Supabase project ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_change-me
SUPABASE_SECRET_KEY=sb_secret_change-me
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# --- Debug endpoint header key (NOT a JWT) ---
DEBUG_ACCESS_KEY=change-me-debug-key

# --- CORS: comma-separated explicit origins, no wildcard ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Deployment ---
# Set true on exactly ONE instance so two instances don't race migrations.
RUN_MIGRATIONS=false
PORT=8000

# --- AI (owned by David; backend only passes through) ---
NVIDIA_API_KEY=
