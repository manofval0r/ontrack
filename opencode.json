{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "supabase": {
        "type": "remote",
        "url": "https://mcp.supabase.com/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:SUPABASE_ACCESS_TOKEN}"
        }
      },
      "expo": {
        "type": "remote",
        "url": "https://mcp.expo.dev/mcp"
      }
    }
  }
}
